{
  "name": "zodi-ai-core",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop:dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "ai": "7.0.179",
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.6",
    "typescript": "^5.9.3",
    "@eslint/eslintrc": "^3.3.1"
  },
  "build": {
    "appId": "fr.zodi.ai",
    "productName": "Zodi AI",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Zodi-AI-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zodi AI"
    }
  }
}