<Window x:Class="ZodiAI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Zodi AI">
<Grid Background="#10131B"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Grid Grid.Column="0" Background="#171B25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Spacing="4" Margin="4,8,4,20"><TextBlock Text="✦  Zodi AI" FontSize="23" FontWeight="SemiBold" Foreground="#F4F6FC"/><TextBlock Text="Tes conversations" FontSize="12" Foreground="#AAB3C5"/></StackPanel>
<Button Grid.Row="1" Content="＋  Nouvelle conversation" HorizontalAlignment="Stretch" Height="42" Click="NewConversation_Click"/>
<ListView x:Name="ConversationList" Grid.Row="2" Margin="0,14,0,12" SelectionChanged="ConversationList_SelectionChanged" Background="Transparent" BorderThickness="0"><ListView.ItemTemplate><DataTemplate><Grid Padding="8,9"><TextBlock Text="{Binding Title}" Foreground="#E8ECF5" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
<TextBlock Grid.Row="3" Text="Historique enregistré sur cet ordinateur" Foreground="#8994A9" FontSize="11" TextWrapping="Wrap" Margin="4,8"/></Grid>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="#191E2A" Padding="22,17"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock x:Name="ConversationTitle" Text="Nouvelle conversation" FontSize="19" FontWeight="SemiBold" Foreground="#F4F6FC"/><TextBlock Text="Assistant personnel · Application Windows native" FontSize="12" Foreground="#AAB3C5"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Mettre à jour" Click="CheckForUpdates_Click"/><Button Content="Renommer" Click="RenameConversation_Click"/><Button Content="Supprimer" Click="DeleteConversation_Click"/></StackPanel></Grid></Border>
<ScrollViewer x:Name="MessagesScroll" Grid.Row="1" Padding="24,20" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MessagesPanel" Spacing="14" MaxWidth="920" HorizontalAlignment="Center"/></ScrollViewer>
<TextBlock x:Name="StatusText" Grid.Row="2" Text="Connexion au service Zodi AI · Internet requis" Foreground="#929DB1" FontSize="12" Margin="28,4,28,10" HorizontalAlignment="Center"/>
<Border Grid.Row="3" Background="#191E2A" Padding="18,14"><Grid MaxWidth="920" HorizontalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="MessageInput" PlaceholderText="Écris ton message à Zodi…" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="130" KeyDown="MessageInput_KeyDown"/><Button x:Name="SendButton" Grid.Column="1" Content="Envoyer" Margin="12,0,0,0" MinWidth="104" Height="48" VerticalAlignment="Bottom" Click="SendButton_Click"/></Grid></Border></Grid></Grid></Window>