<Window x:Class="ZodiAI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Zodi AI">

 <Grid Background="{StaticResource PageBrush}">
  <Grid.Resources>
  <SolidColorBrush x:Key="PageBrush" Color="#090E1B"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#111A2D"/>
  <SolidColorBrush x:Key="PanelAltBrush" Color="#17233A"/>
  <SolidColorBrush x:Key="LineBrush" Color="#283650"/>
  <SolidColorBrush x:Key="TextBrush" Color="#F2F5FF"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#9BA9C3"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#7868F6"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#202D47"/>
   <Setter Property="Foreground" Value="#E7ECFA"/>
   <Setter Property="BorderBrush" Value="#344563"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="11"/>
   <Setter Property="Padding" Value="14,9"/>
   <Setter Property="MinHeight" Value="40"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button">
   <Setter Property="Background" Value="#7868F6"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="CornerRadius" Value="12"/>
   <Setter Property="Padding" Value="18,10"/>
   <Setter Property="MinHeight" Value="46"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  </Grid.Resources>
  <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Grid.Column="0" Background="{StaticResource PanelBrush}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Spacing="5" Margin="22,24,18,24">
    <TextBlock Text="✦  Zodi AI" FontSize="23" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
    <TextBlock Text="Ton espace de conversation" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
   </StackPanel>
   <Button Grid.Row="1" Content="＋  Nouvelle conversation" HorizontalAlignment="Stretch" Margin="16,0,16,8" Height="46" Click="NewConversation_Click" Style="{StaticResource PrimaryButton}"/>
   <ListView x:Name="ConversationList" Grid.Row="2" Margin="12,10,12,12" SelectionChanged="ConversationList_SelectionChanged" Background="Transparent" BorderThickness="0">
    <ListView.ItemTemplate><DataTemplate><Border Padding="8,9" CornerRadius="9"><TextBlock Text="{Binding Title}" Foreground="#E7ECFA" TextTrimming="CharacterEllipsis"/></Border></DataTemplate></ListView.ItemTemplate>
   </ListView>
   <TextBlock Grid.Row="3" Text="Historique enregistré sur cet ordinateur" Foreground="#71819E" FontSize="11" TextWrapping="Wrap" Margin="20,8,20,18"/>
  </Grid>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,18">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="4" VerticalAlignment="Center">
      <TextBlock x:Name="ConversationTitle" Text="Nouvelle conversation" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
      <TextBlock Text="Assistant personnel · Application Windows native" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <Button Content="Mettre à jour" Click="CheckForUpdates_Click"/>
      <Button Content="Renommer" Click="RenameConversation_Click"/>
      <Button Content="Supprimer" Click="DeleteConversation_Click"/>
     </StackPanel>
    </Grid>
   </Border>
   <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" Padding="26,22" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="MessagesPanel" Spacing="14" MaxWidth="920" HorizontalAlignment="Center"/>
   </ScrollViewer>
   <TextBlock x:Name="StatusText" Grid.Row="2" Text="Connexion au service Zodi AI · Internet requis" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="28,4,28,12" HorizontalAlignment="Center"/>
   <Border Grid.Row="3" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,16">
    <Grid MaxWidth="920" HorizontalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="MessageInput" PlaceholderText="Écris ton message à Zodi…" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" MaxHeight="140" KeyDown="MessageInput_KeyDown" VerticalContentAlignment="Center"/>
     <Button x:Name="SendButton" Grid.Column="1" Content="Envoyer  ↗" Margin="12,0,0,0" MinWidth="112" Height="48" VerticalAlignment="Bottom" Click="SendButton_Click" Style="{StaticResource PrimaryButton}"/>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>