<Window
    x:Class="ZodiAI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Zodi IA">
    <Grid Background="#10131B">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#191E2A" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="Zodi IA" FontSize="24" FontWeight="SemiBold" Foreground="#F4F6FC" />
                    <TextBlock Text="Assistant personnel" FontSize="13" Foreground="#AAB3C5" />
                </StackPanel>
                <Border Grid.Column="1" Background="#203C35" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="Application Windows native" Foreground="#9BE2C1" FontSize="12" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" Padding="24,20" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MessagesPanel" Spacing="14" MaxWidth="920" HorizontalAlignment="Center">
                <Border Background="#1B2230" CornerRadius="16" Padding="20" MaxWidth="720" HorizontalAlignment="Left">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Bienvenue dans Zodi IA 👋" FontSize="20" FontWeight="SemiBold" Foreground="#F4F6FC" />
                        <TextBlock Text="Je suis prêt à discuter avec toi. Écris ton premier message ci-dessous." TextWrapping="Wrap" Foreground="#C3CBDA" FontSize="15" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="Connecté au service Zodi IA · Internet requis" Foreground="#929DB1" FontSize="12" Margin="28,4,28,10" HorizontalAlignment="Center" />

        <Border Grid.Row="3" Background="#191E2A" Padding="18,14">
            <Grid MaxWidth="920" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MessageInput" PlaceholderText="Écris ton message à Zodi…" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="130" CornerRadius="12" KeyDown="MessageInput_KeyDown" />
                <Button x:Name="SendButton" Grid.Column="1" Content="Envoyer" Margin="12,0,0,0" MinWidth="104" Height="48" VerticalAlignment="Bottom" Click="SendButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
