<Application
    x:Class="ZodiAI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="PageBrush" Color="#090E1B"/>
            <SolidColorBrush x:Key="PanelBrush" Color="#111A2D"/>
            <SolidColorBrush x:Key="PanelAltBrush" Color="#17233A"/>
            <SolidColorBrush x:Key="LineBrush" Color="#283650"/>
            <SolidColorBrush x:Key="TextBrush" Color="#F2F5FF"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#9BA9C3"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
            <Style TargetType="Button">
            <Setter Property="Background" Value="#263B63"/>
            <Setter Property="Foreground" Value="#E7ECFA"/>
            <Setter Property="BorderBrush" Value="#344563"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#7868F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
