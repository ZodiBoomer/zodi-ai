<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>zodi-ai</AssemblyName>
    <Version>1.7.5.3</Version>
    <RootNamespace>ZodiAI.Linux</RootNamespace>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.4.0"/>
    <PackageReference Include="Avalonia.Desktop" Version="11.4.0"/>
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.4.0"/>
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.4.0"/>
    <PackageReference Include="Avalonia.Controls.WebView" Version="11.4.1"/>
    <Content Include="Assets/zodix-logo.png" Link="zodix-logo.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>